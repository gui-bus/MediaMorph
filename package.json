{
  "name": "mediamorph",
  "version": "1.0.0",
  "description": "Desktop Image & Video Compressor and Converter for Windows",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/gui-bus/MediaMorph.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:frontend": "tsc && vite build",
    "build:exe": "tsc && vite build && electron-builder --win --dir && node scripts/set-icon.mjs",
    "strip-comments": "node scripts/strip-comments.mjs",
    "preview": "vite preview"
  },
  "keywords": [
    "image-converter",
    "image-compressor",
    "video-converter",
    "video-compressor",
    "webp",
    "avif",
    "mp4",
    "ffmpeg",
    "sharp",
    "electron"
  ],
  "author": "Guilherme",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "clsx": "^2.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
